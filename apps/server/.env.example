NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/gurbhej_portfolio
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
ALLOW_START_WITHOUT_DB=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
COOKIE_NAME=portfolio_token
PUBLIC_API_URL=
# Gmail SMTP: use a Google App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-gmail@gmail.com
# Leave this equal to SMTP_USER to receive portfolio messages in that inbox.
CONTACT_RECEIVER=your-gmail@gmail.com
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
